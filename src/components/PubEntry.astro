---
import { paperPath, type Paper } from "@/lib/papers";

interface Props {
  paper: Paper;
  /** Link the title to the paper's own page (off on that page itself). */
  linkTitle?: boolean;
  /** Show the abstract as a collapsible block. */
  showAbstract?: boolean;
  /** Hide the title when the page already shows it as a heading. */
  showTitle?: boolean;
}

const { paper, linkTitle = true, showAbstract = true, showTitle = true } = Astro.props;
---

<article class="py-5 border-b border-line last:border-b-0">
  <p class="text-[15px] text-muted leading-[1.55] m-0 mb-1">
    {
      paper.authors.map((a, i) => (
        <>
          {a.bold ? (
            <strong class="text-ink font-semibold">{a.name}</strong>
          ) : (
            <span>{a.name}</span>
          )}
          {i < paper.authors.length - 1 && <span>, </span>}
        </>
      ))
    }
    <span> ({paper.year}).</span>
  </p>
  {
    showTitle && (
      <p class="font-display text-[17px] text-ink leading-[1.4] m-0 mb-2 font-medium">
        {linkTitle ? (
          <a href={paperPath(paper)} class="text-ink no-underline hover:text-signal-ink">
            {paper.title}
          </a>
        ) : (
          paper.title
        )}
      </p>
    )
  }
  {
    paper.venue && (
      <p class="text-[14px] text-muted m-0 mb-3 italic">{paper.venue}</p>
    )
  }
  <div class="flex flex-wrap gap-2 items-center">
    {
      paper.chips.map((chip) => (
        <a
          href={chip.href}
          class="inline-block font-mono text-[11px] text-signal-ink no-underline px-2.5 py-1 rounded-full border border-line bg-wash hover:bg-signal/10 hover:border-signal-ink/40 uppercase tracking-wide transition-colors"
        >
          {chip.label}
        </a>
      ))
    }
    {
      paper.award && (
        <span class="inline-block font-mono text-[11px] text-signal-ink bg-signal/15 px-2.5 py-1 rounded-full uppercase tracking-wide">
          ★ {paper.award}
        </span>
      )
    }
  </div>
  {
    showAbstract && paper.abstract && (
      <details class="mt-3 group">
        <summary class="cursor-pointer font-mono text-[11px] uppercase tracking-wide text-muted hover:text-ink w-fit">
          Abstract
        </summary>
        <p class="text-[14.5px] text-muted leading-[1.6] mt-2 mb-0 max-w-[75ch]">{paper.abstract}</p>
      </details>
    )
  }
</article>
