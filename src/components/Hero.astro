---
import siteConfig from "@/content/site.yaml";

const eyebrow = `${siteConfig.institution} · ${siteConfig.university}`;
const headlineParts = siteConfig.headline
  .split(/(\*\*[^*]+\*\*)/g)
  .filter((s: string) => s.length > 0)
  .map((seg: string) =>
    seg.startsWith("**") && seg.endsWith("**")
      ? { text: seg.slice(2, -2), accent: true }
      : { text: seg, accent: false }
  );
---

<section class="hero relative isolate -mt-[66px] overflow-hidden bg-[#04060A]">
  <!-- Ambient artwork: animated for motion-OK, static poster for reduced-motion -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <video
      class="hero-motion h-full w-full object-cover object-center"
      autoplay
      muted
      loop
      playsinline
      poster="/images/hero/neurons-poster.jpg"
    >
      <source src="/images/hero/neurons.mp4" type="video/mp4" />
    </video>
    <img
      src="/images/hero/neurons-poster.jpg"
      alt=""
      class="hero-static h-full w-full object-cover object-center"
      loading="eager"
      decoding="async"
    />
    <!-- Light legibility scrims: let the artwork read through; text-shadow carries contrast -->
    <div
      class="absolute inset-0"
      style="background:linear-gradient(90deg,rgba(4,6,10,0.55) 0%,rgba(4,6,10,0.34) 32%,rgba(4,6,10,0.12) 64%,rgba(4,6,10,0) 100%)"
    >
    </div>
    <div
      class="absolute inset-x-0 bottom-0 h-32"
      style="background:linear-gradient(180deg,rgba(4,6,10,0) 0%,rgba(4,6,10,0.7) 100%)"
    >
    </div>
    <!-- Mobile only: uniform darkening so the full-width headline stays legible
         over wherever the artwork crops on a narrow screen -->
    <div class="absolute inset-0 bg-[#04060A]/35 md:hidden"></div>
  </div>

  <div
    class="mx-auto flex min-h-[clamp(520px,74vh,780px)] max-w-[1120px] flex-col justify-center px-7 py-20"
  >
    <div class="hero-copy max-w-[36rem]">
      <p
        class="m-0 mb-5 font-mono text-xs uppercase tracking-[0.18em] text-[#8FE9DC]"
      >
        {eyebrow}
      </p>
      <h1
        class="m-0 mb-6 font-display text-[clamp(36px,4.8vw,60px)] font-medium leading-[1.05] tracking-[-0.02em] text-white"
      >
        {
          headlineParts.map((p: { text: string; accent: boolean }) =>
            p.accent ? (
              <span class="font-bold text-signal">{p.text}</span>
            ) : (
              <span>{p.text}</span>
            )
          )
        }
      </h1>
      <p class="m-0 mb-7 max-w-[46ch] text-[19px] leading-[1.6] text-white/72">
        {siteConfig.tagline}
      </p>
      <p class="m-0 text-[15px] text-white/55">
        A lab led by <a
          href="/pi/"
          class="font-medium text-[#8FE9DC] no-underline hover:underline">Logan
          Grosenick</a
        > at Weill Cornell Medicine, Cornell University.
      </p>
    </div>
  </div>

</section>

<script>
  // Respect reduced-motion: hold the hero video on its poster frame.
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const v = document.querySelector<HTMLVideoElement>(".hero-motion");
    v?.removeAttribute("autoplay");
    v?.pause();
  }
</script>

<style>
  .hero-copy {
    text-shadow: 0 1px 22px rgba(4, 6, 10, 0.65);
  }
  .hero-static {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-motion {
      display: none;
    }
    .hero-static {
      display: block;
    }
  }
</style>
