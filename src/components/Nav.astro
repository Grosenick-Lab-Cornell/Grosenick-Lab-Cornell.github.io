---
import siteConfig from "@/content/site.yaml";

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const { nav, shortName } = siteConfig;
---

<header
  id="siteNav"
  data-overlay={overlay ? "true" : "false"}
  class="sticky top-0 z-50"
>
  <div
    class="mx-auto max-w-[1120px] px-7 h-[66px] flex items-center justify-between"
  >
    <a
      href="/"
      class="brand flex items-center gap-3 font-display font-semibold text-lg tracking-tight no-underline"
    >
      <span class="w-[9px] h-[9px] rounded-full bg-signal ring-4 ring-signal/15"
      ></span>
      <span>{shortName}</span>
    </a>

    <nav class="hidden md:block">
      <ul class="flex gap-7 list-none m-0 p-0">
        {
          nav.map((item: { label: string; href: string }) => (
            <li>
              <a
                href={item.href}
                class="nav-link text-sm font-display font-medium no-underline"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      id="navToggle"
      type="button"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="navMenu"
      class="nav-toggle md:hidden p-2 -mr-2"
    >
      <svg
        viewBox="0 0 24 24"
        width="22"
        height="22"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>

  <div id="navMenu" class="md:hidden hidden border-t border-line bg-paper">
    <ul class="mx-auto max-w-[1120px] px-7 py-3 flex flex-col gap-0 list-none">
      {
        nav.map((item: { label: string; href: string }) => (
          <li>
            <a
              href={item.href}
              class="block py-3 text-base font-display font-medium text-ink no-underline border-b border-line last:border-b-0"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  #siteNav {
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
    border-bottom: 1px solid transparent;
  }
  .brand {
    color: var(--color-ink);
  }
  .nav-link {
    color: var(--color-muted);
  }
  .nav-link:hover {
    color: var(--color-ink);
  }
  .nav-toggle {
    color: var(--color-ink);
  }

  /* Solid chrome: scrolled overlay pages + all non-overlay pages */
  #siteNav.is-solid,
  #siteNav[data-overlay="false"] {
    background: color-mix(in srgb, var(--color-paper) 88%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom-color: var(--color-line);
  }

  /* Transparent overlay over the dark hero (homepage, at the top) */
  #siteNav[data-overlay="true"]:not(.is-solid) .brand {
    color: #fff;
  }
  #siteNav[data-overlay="true"]:not(.is-solid) .nav-link {
    color: rgba(255, 255, 255, 0.8);
  }
  #siteNav[data-overlay="true"]:not(.is-solid) .nav-link:hover {
    color: #fff;
  }
  #siteNav[data-overlay="true"]:not(.is-solid) .nav-toggle {
    color: #fff;
  }
</style>

<script>
  const header = document.getElementById("siteNav");
  const btn = document.getElementById("navToggle");
  const menu = document.getElementById("navMenu");
  const isOverlay = header?.dataset.overlay === "true";

  // Overlay nav: transparent at the top, solid once scrolled (or menu open).
  if (isOverlay && header) {
    const sync = () => {
      const menuOpen = menu ? !menu.classList.contains("hidden") : false;
      header.classList.toggle("is-solid", window.scrollY > 24 || menuOpen);
    };
    sync();
    window.addEventListener("scroll", sync, { passive: true });
    header.addEventListener("nav:menu", sync);
  }

  btn?.addEventListener("click", () => {
    const nowHidden = menu?.classList.toggle("hidden");
    btn.setAttribute("aria-expanded", nowHidden ? "false" : "true");
    header?.dispatchEvent(new CustomEvent("nav:menu"));
  });
  menu?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => {
      menu.classList.add("hidden");
      btn?.setAttribute("aria-expanded", "false");
      header?.dispatchEvent(new CustomEvent("nav:menu"));
    });
  });
</script>
