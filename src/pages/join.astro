---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";

const coordinatorEmail = "jas4060@med.cornell.edu";
const coordinatorName = "Jordan Serrano-Guedea";

const roles = [
  {
    eyebrow: "Postdoc 1",
    title: "Multimodal world models for personalized psychiatry",
    problem: [
      "Treatment selection in psychiatry is fundamentally a counterfactual problem: what would happen to this patient under a different treatment?",
      "We want to build generative world models that learn how brain activity, behavior, facial expression, language, symptoms, and treatment evolve together, and use those models to estimate individualized treatment trajectories and counterfactuals.",
    ],
  },
  {
    eyebrow: "Postdoc 2",
    title: "Generative digital twins and closed-loop neurostimulation",
    problem: [
      "Can we learn a patient-specific dynamical model of the brain well enough to predict, and ultimately control, its response to stimulation?",
      "We are developing generative digital twins of neural dynamics from TMS and high-density EEG, with the long-term goal of moving from prediction to individualized, closed-loop neurostimulation.",
    ],
  },
];

const labelClass =
  "font-display text-ink font-medium text-[17px] m-0 mb-2";
const proseClass = "text-muted text-[16.5px] leading-[1.65] m-0";
---

<Layout
  title="Open positions | Grosenick Lab"
  description="Two open postdoctoral positions at the Grosenick Lab: multimodal world models for personalized psychiatry, and generative digital twins for closed-loop neurostimulation."
>
  <PageHeader
    eyebrow="Open positions"
    title="Two postdoctoral positions in generative AI, computational psychiatry, and neuroengineering."
    lead="We are recruiting two postdoctoral fellows to develop new machine-learning methods for understanding and treating psychiatric illness. Both positions combine fundamental methods development with unusually rich clinical and neural data, with opportunities to lead first-author work in machine learning, computational neuroscience, and psychiatry."
  />

  <div class="mx-auto max-w-[1120px] px-7 py-16 space-y-16">
    <article
      class="grid gap-8 md:grid-cols-[260px_1fr] items-start border border-line rounded-[14px] p-8 bg-paper"
    >
      <div>
        <p
          class="font-mono text-xs uppercase tracking-[0.16em] text-signal-ink m-0 mb-2"
        >
          {roles[0].eyebrow}
        </p>
        <h2
          class="font-display text-[24px] md:text-[26px] font-medium tracking-[-0.01em] m-0"
        >
          {roles[0].title}
        </h2>
      </div>
      <div>
        <p class={labelClass}>The problem</p>
        <p class={`${proseClass} mb-3`}>{roles[0].problem[0]}</p>
        <p class={`${proseClass} mb-6`}>{roles[0].problem[1]}</p>

        <p class={labelClass}>What you could work on</p>
        <p class={`${proseClass} mb-3`}>
          Develop new methods for multimodal generative modeling, diffusion
          and flow models, causal and counterfactual inference,
          representation learning, and behavioral modeling; train them on
          longitudinal clinical datasets spanning brain imaging and
          multimodal behavioral data; and develop methods for testing when
          patient-specific counterfactual predictions are identifiable,
          reliable, and clinically useful.
        </p>
        <p class={`${proseClass} mb-3`}>
          We are also particularly interested in candidates working on <strong
            class="text-ink font-semibold"
            >cross-species pose estimation and behavioral representation
            learning</strong
          >, including methods that identify shared and species-specific
          structure in movement, behavior, and latent neural or affective
          states across humans and animal models.
        </p>
        <p class={`${proseClass} mb-6`}>
          This is a methods-development position, not simply an application
          of existing models to clinical data. The exact direction can be
          shaped around the fellow's interests.
        </p>

        <p class={labelClass}>We are looking for</p>
        <p class={`${proseClass} mb-3`}>
          A PhD in computer science, machine learning, applied mathematics,
          computational neuroscience, or a related quantitative field, with
          strong Python and PyTorch skills and experience in generative
          models, sequence models, representation learning, multimodal
          learning, or pose and behavior modeling.
        </p>
        <p class={proseClass}>
          Experience with diffusion and flow models, world models, causal
          inference, pose estimation, behavioral representation learning, or
          large multimodal datasets is especially useful. Prior psychiatric
          research is not required; interest in using methodological
          advances to answer consequential clinical questions is.
        </p>
      </div>
    </article>

    <article
      class="grid gap-8 md:grid-cols-[260px_1fr] items-start border border-line rounded-[14px] p-8 bg-paper"
    >
      <div>
        <p
          class="font-mono text-xs uppercase tracking-[0.16em] text-signal-ink m-0 mb-2"
        >
          {roles[1].eyebrow}
        </p>
        <h2
          class="font-display text-[24px] md:text-[26px] font-medium tracking-[-0.01em] m-0"
        >
          {roles[1].title}
        </h2>
      </div>
      <div>
        <p class={labelClass}>The problem</p>
        <p class={`${proseClass} mb-3`}>{roles[1].problem[0]}</p>
        <p class={`${proseClass} mb-6`}>{roles[1].problem[1]}</p>

        <p class={labelClass}>What you could work on</p>
        <p class={`${proseClass} mb-3`}>
          Develop models of patient-specific neural dynamics and
          intervention response; solve forward and inverse problems linking
          stimulation to distributed brain activity; develop methods for
          system identification, neural operators, causal dynamics, and
          model-based control; and test these models using clinical TMS-EEG
          data from patients undergoing treatment.
        </p>
        <p class={`${proseClass} mb-6`}>
          The goal is both methodological and translational: new approaches
          to learning controllable neural dynamics, tested in a setting
          where the intervention can actually be delivered.
        </p>

        <p class={labelClass}>We are looking for</p>
        <p class={`${proseClass} mb-3`}>
          A PhD in computational neuroscience, machine learning, electrical
          or biomedical engineering, applied mathematics, or a related
          field, with strong Python and PyTorch skills.
        </p>
        <p class={proseClass}>
          Experience with neural time series, dynamical systems, generative
          modeling, control, EEG and electrophysiology, inverse problems, or
          neural operators would all be relevant. Previous TMS experience is
          helpful but not required.
        </p>
      </div>
    </article>

    <section>
      <p
        class="font-mono text-xs uppercase tracking-[0.16em] text-signal-ink m-0 mb-3"
      >
        Why the Grosenick Lab
      </p>
      <div class="max-w-[68ch]">
        <p class={`${proseClass} mb-4`}>
          The lab works across machine learning, neuroscience, and
          psychiatry at Weill Cornell Medicine and Cornell University.
          Recent work from the group has appeared at ICML, NeurIPS, Science,
          Nature Neuroscience, and other leading venues. See our <a
            href="/publications/"
            class="text-signal-ink hover:underline">publications</a
          > and <a href="/#software" class="text-signal-ink hover:underline"
            >software</a
          > for the kind of work.
        </p>
        <p class={`${proseClass} mb-4`}>
          Postdocs have substantial intellectual ownership of their
          projects, with mentorship aimed at developing an independent
          research program. We support first-author papers, conference
          travel, open-source software development, fellowship and grant
          applications, and collaborations across machine learning,
          psychiatry, neuroscience, and engineering.
        </p>
        <p class={`${proseClass} mb-6`}>
          Former lab members have gone on to faculty positions and research
          roles at organizations including Anthropic and NVIDIA. See <a
            href="/people/#alumni"
            class="text-signal-ink hover:underline">where alumni went</a
          >.
        </p>
        <p class={`${proseClass} mb-2`}>
          <strong class="text-ink font-semibold">Location:</strong> New York
          City, Weill Cornell Medicine.
        </p>
        <p class={proseClass}>
          <strong class="text-ink font-semibold">Salary:</strong> starts at
          $76,000 and scales with experience, subject to Weill Cornell
          Medicine policy.
        </p>
      </div>
    </section>

    <section class="pt-14 border-t border-line">
      <p
        class="font-mono text-xs uppercase tracking-[0.16em] text-signal-ink m-0 mb-3"
      >
        How to apply
      </p>
      <h2
        class="font-display text-[26px] md:text-[28px] font-medium tracking-[-0.015em] m-0 mb-4 max-w-[44ch]"
      >
        Please email our lab coordinator.
      </h2>
      <p class="text-muted text-[17px] leading-[1.65] max-w-[62ch] m-0 mb-4">
        Write to <strong class="text-ink font-semibold">{coordinatorName}</strong
        > at <a
          href={`mailto:${coordinatorEmail}`}
          class="text-signal-ink font-medium hover:underline"
          >{coordinatorEmail}</a
        > with:
      </p>
      <ul
        class="text-muted text-[16.5px] leading-[1.65] list-disc pl-5 m-0 mb-5 space-y-2 max-w-[62ch]"
      >
        <li>your CV;</li>
        <li>
          a short note describing which position interests you and the
          research questions you would most like to pursue;
        </li>
        <li>one or two representative papers or projects; and</li>
        <li>your preferred start date.</li>
      </ul>
      <p class="text-muted text-[17px] leading-[1.65] max-w-[62ch] m-0 mb-7">
        Applications will be considered on a rolling basis.
      </p>
      <a
        href={`mailto:${coordinatorEmail}`}
        class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-ink text-paper font-display font-medium text-sm no-underline hover:bg-signal-ink transition-colors"
      >
        Email the lab coordinator
      </a>
    </section>
  </div>
</Layout>
