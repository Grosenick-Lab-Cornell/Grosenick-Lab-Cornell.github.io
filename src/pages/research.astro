---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getCollection, render } from "astro:content";
import { publicAssetExists } from "@/lib/assets";
import { getAllPapers, paperPath } from "@/lib/papers";

const themes = (await getCollection("research")).sort(
  (a, b) => a.data.order - b.data.order
);
const papersByKey = new Map(getAllPapers().map((p) => [p.key, p]));

const rendered = await Promise.all(
  themes.map(async (t) => {
    const { Content } = await render(t);
    const keyPapers = (t.data.papers ?? []).map((key) => {
      const paper = papersByKey.get(key);
      if (!paper) throw new Error(`research/${t.id}: unknown paper key "${key}"`);
      return paper;
    });
    return {
      data: t.data,
      id: t.id,
      Content,
      keyPapers,
      showFigure: publicAssetExists(t.data.figure),
    };
  })
);
---

<Layout
  title="Research | Grosenick Lab"
  description="Research at the Grosenick Lab: biological subtypes, personalized treatment, machine learning for neural and biomedical data, and neuroengineering."
>
  <PageHeader
    eyebrow="Research"
    title="What we work on."
    lead="Biological subtypes of psychiatric illness, personalized treatment, machine learning for neural and biomedical data, and the neurotechnology that produces those data."
  />

  <div class="mx-auto max-w-[1120px] px-7 py-16 space-y-20">
    {
      rendered.map(({ data, Content, keyPapers, showFigure }, i) => (
        <article
          class={`grid gap-10 md:grid-cols-2 items-center ${i % 2 === 1 ? "md:[&>figure]:order-2" : ""}`}
        >
          <figure class="m-0">
            <div class="aspect-[4/3] rounded-[14px] overflow-hidden bg-wash border border-line flex items-center justify-center relative">
              {showFigure ? (
                <img
                  src={data.figure}
                  alt={data.figureCaption ?? data.title}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              ) : (
                <div
                  class="absolute inset-0 flex items-center justify-center"
                  style="background:radial-gradient(130% 130% at 28% 22%, rgba(236,77,125,0.07), transparent 62%)"
                >
                  <span
                    class="w-2.5 h-2.5 rounded-full bg-signal/55 ring-4 ring-signal/10"
                  />
                </div>
              )}
            </div>
            {data.figureCaption && (
              <figcaption class="font-mono text-[11px] text-faint mt-3 leading-relaxed max-w-[44ch]">
                {data.figureCaption}
              </figcaption>
            )}
          </figure>

          <div>
            <h2 class="font-display text-[28px] md:text-[30px] font-medium tracking-[-0.015em] m-0 mb-4">
              {data.title}
            </h2>
            <div class="text-[16.5px] text-muted leading-[1.65] [&_strong]:text-ink [&_strong]:font-semibold [&_em]:italic [&_p]:m-0">
              <Content />
            </div>
            {keyPapers.length > 0 && (
              <div class="mt-6">
                <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-faint m-0 mb-2">Key papers</p>
                <ul class="list-none p-0 m-0 space-y-1.5">
                  {keyPapers.map((p) => (
                    <li class="text-[14.5px] leading-[1.45]">
                      <a href={paperPath(p)} class="text-ink no-underline hover:text-signal-ink">
                        {p.title}
                      </a>
                      <span class="text-faint">
                        {" "}
                        ({p.venue ? `${p.venue}, ` : ""}
                        {p.year})
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </article>
      ))
    }
  </div>
</Layout>
